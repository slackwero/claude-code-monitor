{
  "name": "claude-code-monitor",
  "version": "1.0.0",
  "description": "Pixel-art kiosk dashboard that monitors your Claude Code sessions and casts to a Google Nest Hub — with remote touch approval",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slackwero/claude-code-monitor.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server/server.js",
    "install-hooks": "node hooks/install-hooks.js",
    "uninstall-hooks": "node hooks/install-hooks.js --uninstall",
    "cast": "sh scripts/cast.sh",
    "keepalive": "node scripts/keepalive.js",
    "autostart": "sh scripts/install-autostart.sh",
    "autostart-off": "sh scripts/install-autostart.sh --uninstall"
  }
}
