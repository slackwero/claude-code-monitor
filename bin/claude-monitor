#!/bin/sh
# CLI del Nest Hub Monitor. Instalado como symlink en ~/.local/bin/claude-monitor.
set -e

SELF="$0"
[ -L "$SELF" ] && SELF="$(readlink "$SELF")"
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
PATH="$HOME/.local/bin:$PATH"
LOGS="$HOME/Library/Logs/nest-hub-monitor"
PORT="$(node -p "require('$DIR/config.json').port" 2>/dev/null || echo 8787)"
DEVICE="${CATT_DEVICE:-$(node -p "require('$DIR/config.json').device" 2>/dev/null)}"

case "$1" in
  start)
    sh "$DIR/scripts/install-autostart.sh"
    echo "Monitor arriba. Sobrevive reinicios de la Mac (launchd)."
    ;;
  stop)
    sh "$DIR/scripts/install-autostart.sh" --uninstall
    echo "Monitor detenido (servidor + keepalive)."
    ;;
  restart)
    sh "$DIR/scripts/install-autostart.sh"
    ;;
  status)
    printf "servidor    : "
    if curl -s -o /dev/null --connect-timeout 2 "http://127.0.0.1:$PORT/"; then echo "OK (:$PORT)"; else echo "CAIDO"; fi
    printf "launchd     : "
    launchctl list 2>/dev/null | grep -q com.nest-hub-monitor.server && echo "instalado" || echo "no instalado (usa: claude-monitor start)"
    printf "hub (%s): " "$DEVICE"
    APP="$(catt -d "$DEVICE" info 2>/dev/null | sed -n 's/^app_id: //p')"
    if [ "$APP" = "84912283" ]; then echo "mostrando dashboard"; elif [ -n "$APP" ]; then echo "en otra app ($APP)"; else echo "no responde"; fi
    ;;
  cast)
    sh "$DIR/scripts/cast.sh"
    ;;
  logs)
    tail -n 40 -f "$LOGS"/com.nest-hub-monitor.*.log
    ;;
  hooks)
    node "$DIR/hooks/install-hooks.js"
    ;;
  hooks-off)
    node "$DIR/hooks/install-hooks.js" --uninstall
    ;;
  *)
    cat <<EOF
claude-monitor — dashboard de Claude Code en el Nest Hub

  claude-monitor start      levanta todo (servidor + keepalive) y lo deja
                            instalado para que arranque solo al iniciar sesión
  claude-monitor stop       detiene y desinstala el autostart
  claude-monitor restart    relanza los servicios
  claude-monitor status     servidor, launchd y estado del Hub
  claude-monitor cast       fuerza un re-cast al Hub ahora
  claude-monitor logs       sigue los logs en vivo (Ctrl-C para salir)
  claude-monitor hooks      (re)instala los hooks de Claude Code
  claude-monitor hooks-off  quita los hooks
EOF
    ;;
esac
